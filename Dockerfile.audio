# Kurai's audio analysis image (`kurai audio`, the compose profile «audio»): Kurai with Essentia and PyTorch (CPU).
# Linux x86_64 only (Essentia's wheels). The models are downloaded at first use into /models (a volume).
# Python goes in two layers, as in Dockerfile: the libraries (~1.5 GB, rebuilt only when they change) and Kurai itself.
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.7

FROM python:3.12-slim AS lock
WORKDIR /lock
COPY pyproject.toml uv.lock docker/without-version.py ./
RUN python without-version.py && rm without-version.py && touch -d @0 pyproject.toml uv.lock

FROM ${UV_IMAGE} AS uv
FROM python:3.12-slim AS wheel
WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
RUN --mount=type=bind,from=uv,source=/uv,target=/bin/uv uv build --wheel --out-dir /dist

FROM python:3.12-slim
RUN useradd --uid 1000 --create-home kurai && mkdir /models && chown kurai /models
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/app/.venv
COPY --from=lock /lock /lock
RUN --mount=type=bind,from=uv,source=/uv,target=/bin/uv \
    cd /lock && uv sync --frozen --no-dev --extra audio --no-install-project --no-cache
RUN --mount=type=bind,from=uv,source=/uv,target=/bin/uv --mount=type=bind,from=wheel,source=/dist,target=/dist \
    uv pip install --python /app/.venv/bin/python --no-deps --no-cache /dist/*.whl
# HF_HOME: transformers' cache next to the models, so any PUID can write it
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 KURAI_AUDIO_MODELS_DIR=/models HF_HOME=/models/.cache \
    HF_HUB_OFFLINE=1
USER kurai
WORKDIR /app
EXPOSE 8097
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"KURAI_AUDIO_PORT\",\"8097\")}/healthz')" || exit 1
CMD ["kurai", "audio"]
