# Kurai's audio analysis image (`kurai audio`, the compose profile «audio»): Kurai with Essentia and PyTorch (CPU).
# Linux x86_64 only (Essentia's wheels). The models are downloaded at first use into /models (a volume).
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra audio --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --extra audio --no-editable

FROM python:3.12-slim
RUN useradd --uid 1000 --create-home kurai && mkdir /models && chown kurai /models
COPY --from=build /app/.venv /app/.venv
# HF_HOME: transformers' cache next to the models, so any PUID can write it
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 KURAI_AUDIO_MODELS_DIR=/models HF_HOME=/models/.cache \
    HF_HUB_OFFLINE=1
USER kurai
WORKDIR /app
EXPOSE 8097
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"KURAI_AUDIO_PORT\",\"8097\")}/healthz')" || exit 1
CMD ["kurai", "audio"]
