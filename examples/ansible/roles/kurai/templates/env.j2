{# The repository's .env.example, line by line, with the values set here: a variable added to .env.example in a new
   release comes along with its default. #}
{% set values = {
  "KURAI_VERSION": kurai_version,
  "KURAI_SECRET_KEY": vault_kurai_secret_key,
  "KURAI_DIR": kurai_dir,
  "KURAI_BASE_URL": kurai_base_url,
  "PUID": kurai_puid,
  "PGID": kurai_pgid,
  "COMPOSE_PROFILES": kurai_profiles,
  "POSTGRES_PASSWORD": vault_kurai_db_password | default(''),
  "KURAI_WEB_PORT": kurai_web_port,
} | combine(kurai_env) %}
# Made by Ansible from .env.example of Kurai {{ kurai_version }}: change the variables, not this file.
{% for line in lookup('ansible.builtin.file', kurai_repo ~ '/.env.example').splitlines() %}
{% set name = line.split('=', 1)[0] %}
{% if not line.startswith('#') and '=' in line and name in values %}
{{ name }}={{ values[name] }}
{% else %}
{{ line }}
{% endif %}
{% endfor %}
