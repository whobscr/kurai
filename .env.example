# Kurai's environment. Copy to .env and fill in. Almost everything else is set later on the system settings page.

# ---------- required ----------
# signs the sessions and encrypts the secrets Kurai stores (API keys, tokens): a long random string, e.g.
# `openssl rand -hex 32`. Changing it logs everyone out and makes the stored secrets unreadable.
KURAI_SECRET_KEY=
# where everything lives on the host: data/music (the library), config/navidrome, and postgres/ and models/ (with
# the db / cpu / audio profiles)
KURAI_DIR=/srv/kurai-data
# the address people open (behind your reverse proxy with TLS)
KURAI_BASE_URL=https://music.example.org
# the account the containers write as (`id -u`, `id -g` of the owner of KURAI_DIR)
PUID=1000
PGID=1000
TZ=Europe/Moscow

# ---------- which parts to run ----------
#   db   PostgreSQL with pgvector      cpu / gpu   local models (llama.cpp)
#   audio   the audio analysis (Essentia and CLAP; then switch it on on the «Звук» tab)
COMPOSE_PROFILES=db,cpu

# ---------- database ----------
POSTGRES_PASSWORD=
KURAI_DATABASE_URL=postgresql+psycopg://kurai:${POSTGRES_PASSWORD}@postgres:5432/kurai

# ---------- the release ----------
KURAI_VERSION=1.4.0

# ---------- ports (published on KURAI_BIND, 127.0.0.1 by default) ----------
KURAI_BIND=127.0.0.1
KURAI_WEB_PORT=8095
NAVIDROME_PORT=4533

# ---------- how Kurai reaches the apps (compose service names by default) ----------
KURAI_NAVIDROME_URL=http://navidrome:4533
# Kurai's network and the web container's fixed address in it: Navidrome trusts Kurai's login header from that
# address only (change all three together if the range is taken on your host; with network_mode: host,
# ND_REVERSEPROXYWHITELIST=127.0.0.1/32)
KURAI_SUBNET=172.31.95.0/24
KURAI_WEB_IP=172.31.95.10
ND_REVERSEPROXYWHITELIST=172.31.95.10/32

# ---------- models: first values (the settings page wins once saved) ----------
KURAI_LLM_BASE_URL=http://llama:8080/v1
KURAI_LLM_MODEL=qwen3
KURAI_LLM_API_KEY=
KURAI_EMBED_BASE_URL=http://llama-embed:8080/v1
KURAI_EMBED_MODEL=qwen3-embedding
# with the cpu / gpu profiles: which models llama.cpp downloads, and how many requests it takes at once
LLAMA_MODEL=bartowski/Qwen_Qwen3-8B-GGUF:Q4_K_M
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
LLAMA_PARALLEL=2

# ---------- the audio analysis (the audio profile) ----------
KURAI_AUDIO_URL=http://audio:8097
# CPU threads the models use, and the container's limits (it runs at night, next to everything else)
KURAI_AUDIO_THREADS=2
KURAI_AUDIO_CPUS=2
KURAI_AUDIO_MEMORY=3g

# ---------- outbound gateway: first value (e.g. socks5h://10.0.0.2:1080); empty: direct ----------
KURAI_OUTBOUND_PROXY=

# ---------- Telegram bot (optional; can also be entered later on the settings page) ----------
KURAI_TELEGRAM_BOT_TOKEN=
